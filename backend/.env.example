# ==========================================
# Knowledge Retrieval Engine (KRE) Config
# ==========================================

# Environment Mode
# "dev" routes to floci (LocalStack) for RDS and ElastiCache.
# "prod" routes to real AWS RDS and ElastiCache.
ENVIRONMENT=dev

# Model Provider
# "dev" routes to OpenRouter for Embeddings, LLM, and Reranker.
# "prod" routes to AWS Bedrock for Embeddings, LLM, and Reranker.
MODEL_PROVIDER=dev

# ==========================================
# Local Emulation (floci / LocalStack)
# ==========================================
# Endpoint for AWS services (S3, etc.) simulated locally.
# Note: Bedrock and Lambda ignore this and ALWAYS use real AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566

# Local Postgres via floci
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kre

# Local Redis via floci (if applicable to your local caching logic)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Real Cloud Endpoints (Outside Local Env)
# ==========================================

# OpenRouter Configuration (Required if MODEL_PROVIDER=dev)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Configuration 
# ONLY required if MODEL_PROVIDER=prod or ENVIRONMENT=prod. 
# If you are running strictly in dev mode, you can leave these blank!
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Target Lambda for PDF Extraction (Must exist in your real AWS account for PROD)
# Note: In DEV mode (ENVIRONMENT=dev), this is bypassed and runs locally.
ODL_PARSER_LAMBDA_NAME=odl-parser-lambda

# S3 Bucket Name for Document Uploads (Used in PROD mode)
# In DEV mode, local files are processed directly without S3.
S3_BUCKET_NAME=kre-documents-prod

# ==========================================
# Model Name Overrides (Optional)
# ==========================================
# The application automatically selects the correct models based on MODEL_PROVIDER (dev vs prod).
# You can override the specific model names below if needed.

# DEV Models (OpenRouter)
DEV_LLM_MODEL=nvidia/nemotron-nano-9b-v2:free
DEV_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
DEV_RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
DEV_CONCEPT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# PROD Models (Bedrock)
PROD_LLM_MODEL=amazon.nova-lite-v1:0
PROD_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
PROD_RERANKER_MODEL=cohere.rerank-v3-5:0
PROD_CONCEPT_MODEL=amazon.nova-micro-v1:0
