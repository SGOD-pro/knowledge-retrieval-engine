# ==========================================
# Knowledge Retrieval Engine (KRE) Config
# ==========================================

# Environment Mode: "dev" or "prod"
# Dev and prod both use AWS Bedrock with the standard AWS SDK credential chain.
# Dev defaults DynamoDB tables and S3 buckets to isolated *-dev / *_dev names
# unless explicitly overridden below.
ENVIRONMENT=dev

# AWS SDK Credential Chain (optional AWS_PROFILE; uses default chain / IAM role when unset)
AWS_REGION=ap-south-1
# AWS_PROFILE=aws

# Optional explicit DynamoDB / S3 resource overrides (preserved for existing deployments)
# DYNAMODB_TABLE_NAME=kre-table-dev
# DYNAMODB_OKF_TABLE_NAME=kre_okf_facts_dev
# DYNAMODB_GRAPH_TABLE_NAME=kre_knowledge_graph_dev
# S3_BUCKET_NAME=kre-documents-dev
# S3_PAGEINDEX_BUCKET=kre-storage-dev
# S3_BENCHMARK_BUCKET=kre-benchmarks-dev

# Local Redis
REDIS_URL=redis://localhost:6379/0

# Target Lambdas
ODL_PARSER_LAMBDA_NAME=odl-parser-lambda-prod
BGE_EMBEDDING_LAMBDA_NAME=bge-text-embeder

# Bedrock Models (shared across dev and prod)
PROD_LLM_MODEL=apac.amazon.nova-lite-v1:0
PROD_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
PROD_CONCEPT_MODEL=apac.amazon.nova-micro-v1:0

# Bedrock Reranker (fallback: BM25Plus lexical scoring)
BEDROCK_RERANKER_ENABLED=true
BEDROCK_RERANKER_MODEL=amazon.rerank-v1:0
BEDROCK_RERANKER_REGION=us-west-2
RERANKER_PROVIDER=bedrock

# LAYA Bounded Escalation Endpoint
LAYA_ENDPOINT_URL=https://your-tunnel.trycloudflare.com/v1/systemone
LAYA_API_KEY=your_laya_api_key_here
