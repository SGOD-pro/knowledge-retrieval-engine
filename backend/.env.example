# ==========================================
# Knowledge Retrieval Engine (KRE) Config
# ==========================================

# Environment Mode
# "dev" routes to floci (LocalStack) for RDS and ElastiCache.
# "prod" routes to real AWS RDS and ElastiCache.
ENVIRONMENT=dev

# Model Provider
# "dev" routes to OpenRouter for Embeddings, LLM, and Reranker.
# "prod" routes to AWS Bedrock for Embeddings, LLM, and Reranker.
MODEL_PROVIDER=dev

# ==========================================
# Local Emulation (floci / LocalStack)
# ==========================================
# Endpoint for AWS services (S3, etc.) simulated locally.
# Note: Bedrock and Lambda ignore this and ALWAYS use real AWS endpoints.
AWS_ENDPOINT_URL=http://localhost:4566

# Local Postgres via floci
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kre

# Local Redis via floci (if applicable to your local caching logic)
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Real Cloud Endpoints (Outside Local Env)
# ==========================================

# OpenRouter Configuration (Required if MODEL_PROVIDER=dev)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Configuration (Required for Bedrock models and ODL Parser Lambda)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# Target Lambda for PDF Extraction (Must exist in your real AWS account)
ODL_PARSER_LAMBDA_NAME=odl-parser-lambda
