# Environment (development | production)
ENVIRONMENT=development
# Provider selection (dev | prod)
# dev = OpenRouter free-tier, prod = AWS Bedrock
MODEL_PROVIDER=dev

# OpenRouter (Required if MODEL_PROVIDER=dev)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AWS Credentials for Bedrock (Required if MODEL_PROVIDER=prod)
AWS_REGION=us-east-1
# Either use AWS_PROFILE or explicit keys
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Infrastructure (Local Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kre
REDIS_URL=redis://localhost:6379/0
