# Environment (dev | prod)
ENVIRONMENT=dev

# AWS SDK Credential Chain for Bedrock, DynamoDB, and S3
# Uses the standard AWS SDK credential chain (or AWS_PROFILE if set) in both dev and prod.
AWS_REGION=ap-south-1
# AWS_PROFILE=aws
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Infrastructure (Local Docker Compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kre
REDIS_URL=redis://localhost:6379/0
